            && (request.auth.uid == resource.data.callerUid ? request.resource.data.get('calleePresent',true) == resource.data.get('calleePresent',true) : request.resource.data.get('callerPresent',true) == resource.data.get('callerPresent',true))
            && request.resource.data.get('callerPresent',true) is bool && request.resource.data.get('calleePresent',true) is bool
            && (request.resource.data.status != 'ended' || (request.resource.data.callerPresent == false && request.resource.data.calleePresent == false))
            && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['rejoinOffer']) || (request.resource.data.rejoinOffer.keys().hasOnly(['uid','sdp','revision','id','deviceId','protocol','preparedAt']) && request.resource.data.rejoinOffer.uid == request.auth.uid && request.resource.data.rejoinOffer.sdp is string && request.resource.data.rejoinOffer.sdp.size() < 30000 && request.resource.data.rejoinOffer.revision == resource.data.get('rejoinOffer',{}).get('revision',0)+1
              && request.resource.data.rejoinOffer.protocol == 2 && request.resource.data.rejoinOffer.id is string && request.resource.data.rejoinOffer.id.size() <= 80 && request.resource.data.rejoinOffer.deviceId is string && request.resource.data.rejoinOffer.deviceId.size() <= 80
              && request.resource.data.rejoinOffer.preparedAt == request.time
              && (resource.data.get('rejoinOffer',{}).get('preparedAt',request.time-duration.value(31,'s'))+duration.value(30,'s') <= request.time || resource.data.get('rejoinCommit',{}).get('revision',-1) == resource.data.get('rejoinOffer',{}).get('revision',0) || resource.data.get('rejoinCancel',{}).get('revision',-1) == resource.data.get('rejoinOffer',{}).get('revision',0)))))
            || (resource.data.status == 'active' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rejoinReady','updatedAt'])
              && request.auth.uid != resource.data.rejoinOffer.uid && request.resource.data.rejoinReady.keys().hasOnly(['uid','id','revision','at']) && request.resource.data.rejoinReady.uid == request.auth.uid
              && request.resource.data.rejoinReady.id == resource.data.rejoinOffer.id && request.resource.data.rejoinReady.revision == resource.data.rejoinOffer.revision && request.resource.data.rejoinReady.at == request.time && resource.data.rejoinOffer.preparedAt+duration.value(30,'s') > request.time)
            || (resource.data.status == 'active' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rejoinCommit','updatedAt'])
              && request.auth.uid == resource.data.rejoinOffer.uid && request.resource.data.rejoinCommit.keys().hasOnly(['uid','id','revision','deviceId','at']) && request.resource.data.rejoinCommit.uid == request.auth.uid
              && request.resource.data.rejoinCommit.id == resource.data.rejoinOffer.id && request.resource.data.rejoinCommit.revision == resource.data.rejoinOffer.revision && request.resource.data.rejoinCommit.deviceId == resource.data.rejoinOffer.deviceId
              && request.resource.data.rejoinCommit.at == request.time && resource.data.rejoinOffer.preparedAt+duration.value(30,'s') > request.time && resource.data.rejoinReady.id == resource.data.rejoinOffer.id
              && resource.data.get('rejoinCancel',{}).get('id','') != resource.data.rejoinOffer.id && resource.data.get('rejoinCommit',{}).get('id','') != resource.data.rejoinOffer.id)
            || (resource.data.status == 'active' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rejoinCancel','updatedAt'])
              && request.resource.data.rejoinCancel.keys().hasOnly(['uid','id','revision','at']) && request.resource.data.rejoinCancel.uid == request.auth.uid && request.resource.data.rejoinCancel.at == request.time
              && request.resource.data.rejoinCancel.id == resource.data.rejoinOffer.id && request.resource.data.rejoinCancel.revision == resource.data.rejoinOffer.revision && resource.data.get('rejoinCommit',{}).get('id','') != resource.data.rejoinOffer.id)
            || (resource.data.status == 'active'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rejoinAnswer','updatedAt'])
            && request.resource.data.rejoinAnswer.keys().hasOnly(['uid','sdp','revision'])
            && request.resource.data.rejoinAnswer.uid == request.auth.uid && request.auth.uid != resource.data.rejoinOffer.uid
            && request.resource.data.rejoinAnswer.sdp is string && request.resource.data.rejoinAnswer.sdp.size() < 30000
            && request.resource.data.rejoinAnswer.revision == resource.data.rejoinOffer.revision)
            || (resource.data.status == 'ringing'
            && request.auth.uid == resource.data.calleeUid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','answer','updatedAt'])
            && request.resource.data.status == 'active'
            && request.resource.data.answer.type == 'answer'
            && request.resource.data.answer.sdp is string
            && request.resource.data.answer.sdp.size() < 30000)
            || (resource.data.status in ['ringing','active']
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt'])
            && request.resource.data.status == 'ended')
            || (resource.data.status == 'active' && request.auth.uid == resource.data.callerUid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['restartOffer','updatedAt'])
              && request.resource.data.restartOffer.keys().hasOnly(['type','sdp','revision'])
              && request.resource.data.restartOffer.type == 'offer' && request.resource.data.restartOffer.sdp is string && request.resource.data.restartOffer.sdp.size() < 30000 && request.resource.data.restartOffer.revision is number)
            || (resource.data.status == 'active' && request.auth.uid == resource.data.calleeUid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['restartAnswer','updatedAt'])
              && request.resource.data.restartAnswer.keys().hasOnly(['type','sdp','revision'])
              && request.resource.data.restartAnswer.type == 'answer' && request.resource.data.restartAnswer.sdp is string && request.resource.data.restartAnswer.sdp.size() < 30000 && request.resource.data.restartAnswer.revision == resource.data.restartOffer.revision)
            || (resource.data.status == 'active' && request.auth.uid == resource.data.calleeUid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['restartRequestedAt','updatedAt']) && request.resource.data.restartRequestedAt == request.time));
        allow delete: if false;
        match /candidates/{candidateId} {
          function conversation() { return get(/databases/$(database)/documents/apps/rd/connections/$(id)).data; }
          allow get, list: if member(conversation());
          allow create: if member(conversation()) && conversation().status == 'accepted'
            && request.resource.data.keys().hasOnly(['uid','candidate','sdpMid','sdpMLineIndex','createdAt','epoch'])
            && request.resource.data.uid == request.auth.uid
            && (!('epoch' in request.resource.data) || request.resource.data.epoch is number)
            && request.resource.data.candidate is string
            && request.resource.data.candidate.size() < 4000
            && request.resource.data.createdAt == request.time;
          allow update, delete: if false;
        }
        match /movie/{movieId} {
          function conversation() { return get(/databases/$(database)/documents/apps/rd/connections/$(id)).data; }
          function call() { return get(/databases/$(database)/documents/apps/rd/connections/$(id)/calls/$(callId)).data; }
          function validMovie() {
            return request.resource.data.keys().hasOnly(['url','title','poster','captionUrl','position','playing','controllerUid','updatedAt','intent'])
              && request.resource.data.url is string
              && request.resource.data.url.matches('^https://cnx-rd-media[.]pixlcyd[.]workers[.]dev/media/.+[.](mp4|webm|mov|mp3|m4a|wav|ogg|weba)$')
              && request.resource.data.title is string && request.resource.data.title.size() <= 120
              && request.resource.data.poster is string && request.resource.data.poster.size() <= 400
              && request.resource.data.captionUrl is string && request.resource.data.captionUrl.size() <= 400
              && request.resource.data.position is number && request.resource.data.position >= 0 && request.resource.data.position <= 86400
              && request.resource.data.playing is bool
              && request.resource.data.controllerUid == request.auth.uid
              && (!('intent' in request.resource.data) || request.resource.data.intent in ['select','seek','play','pause','heartbeat'])
              && request.resource.data.updatedAt == request.time;
          }
          allow get, list: if movieId == 'current' && member(conversation()) && conversation().status == 'accepted';
          allow create, update: if movieId == 'current' && member(conversation()) && conversation().status == 'accepted' && call().status in ['ringing','active'] && validMovie();
          allow delete: if false;
        }
      }
      match /watch/{watchId} {
        function conversation() { return get(/databases/$(database)/documents/apps/rd/connections/$(id)).data; }
        function validWatch() {
          return request.resource.data.keys().hasOnly(['url','title','position','playing','updatedAt','startedBy'])
            && request.resource.data.url is string
            && request.resource.data.url.matches('^https://cnx-rd-media[.]pixlcyd[.]workers[.]dev/media/.+')
            && request.resource.data.title is string
            && request.resource.data.title.size() <= 100
            && request.resource.data.position is number
            && request.resource.data.position >= 0
            && request.resource.data.position <= 21600
            && request.resource.data.playing is bool
            && request.resource.data.updatedAt == request.time
            && request.resource.data.startedBy == request.auth.uid;
        }
        allow get, list: if watchId == 'current' && member(conversation()) && conversation().status == 'accepted';
        allow create, update: if watchId == 'current' && member(conversation()) && conversation().status == 'accepted' && validWatch();
        allow delete: if false;
      }
    }
    match /groups/{groupId} {
      function groupMember(data) { return signedIn() && request.auth.uid in data.members; }
      function groupAdmin(data) { return groupMember(data) && (request.auth.uid == data.ownerUid || request.auth.uid in data.admins); }
      function validGroup(data) {
        return data.keys().hasOnly(['name','ownerUid','admins','members','createdAt','updatedAt'])
          && data.name is string && data.name.size() >= 2 && data.name.size() <= 40
          && data.ownerUid is string
          && data.members is list && data.members.size() >= 1 && data.members.size() <= 20
          && data.admins is list && data.admins.size() >= 1 && data.admins.size() <= data.members.size()
          && data.ownerUid in data.members && data.ownerUid in data.admins
          && data.members.hasAll(data.admins);
      }
      allow get, list: if groupMember(resource.data);
      allow create: if signedIn() && validGroup(request.resource.data)
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.members.size() >= 2
        && request.resource.data.members[0] == request.auth.uid
        && request.resource.data.admins == [request.auth.uid]
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if groupMember(resource.data) && validGroup(request.resource.data)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt'])
          || (request.auth.uid == resource.data.ownerUid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','admins','members','updatedAt']))
          || (groupAdmin(resource.data)
            && request.resource.data.admins == resource.data.admins
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','members','updatedAt']))
          || (request.auth.uid != resource.data.ownerUid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['admins','members','updatedAt'])
            && !(request.auth.uid in request.resource.data.members)
            && request.resource.data.members.toSet() == resource.data.members.toSet().difference([request.auth.uid].toSet())
            && request.resource.data.admins.toSet() == resource.data.admins.toSet().difference([request.auth.uid].toSet()))
        );
      allow delete: if false;
      match /watch/{watchId} {
        function group(){return get(/databases/$(database)/documents/apps/rd/groups/$(groupId)).data;}
        allow get,list: if groupMember(group());
        allow create,update: if watchId == 'current' && groupMember(group())
          && request.resource.data.keys().hasOnly(['url','title','poster','captionUrl','position','playing','controllerUid','updatedAt','intent'])
          && request.resource.data.url is string && request.resource.data.url.matches('^https://cnx-rd-media[.]pixlcyd[.]workers[.]dev/media/.+[.](mp4|webm|mov|mp3|m4a|wav|ogg|weba)$')
          && request.resource.data.title is string && request.resource.data.title.size() <= 120
          && request.resource.data.poster is string && request.resource.data.poster.size() <= 400
          && request.resource.data.captionUrl is string && request.resource.data.captionUrl.size() <= 400
          && request.resource.data.position is number && request.resource.data.position >= 0 && request.resource.data.position <= 86400
          && request.resource.data.playing is bool && request.resource.data.controllerUid == request.auth.uid
          && request.resource.data.intent in ['select','seek','play','pause','heartbeat'] && request.resource.data.updatedAt == request.time;
        allow delete: if false;
      }
      match /messages/{messageId} {
        function group() { return get(/databases/$(database)/documents/apps/rd/groups/$(groupId)).data; }
        allow get, list: if groupMember(group());
        allow create: if groupMember(group()) && validSharedMessage(request.resource.data);
        allow update: if groupMember(group()) && validSharedUpdate(group().members,true);
          allow delete: if groupMember(group()) && (resource.data.senderUid == request.auth.uid || groupAdmin(group()));
      }
    }
    match /servers/{serverId} {
      function serverMember(data) { return signedIn() && request.auth.uid in data.members; }
      function serverAdmin(data) { return serverMember(data) && (request.auth.uid == data.ownerUid || request.auth.uid in data.admins); }
      function validServer(data) {
        return data.keys().hasOnly(['name','ownerUid','admins','members','createdAt','updatedAt'])
          && data.name is string && data.name.size() >= 2 && data.name.size() <= 40
          && data.ownerUid is string
          && data.members is list && data.members.size() >= 1 && data.members.size() <= 100
          && data.admins is list && data.admins.size() >= 1 && data.admins.size() <= data.members.size()
          && data.ownerUid in data.members && data.ownerUid in data.admins
          && data.members.hasAll(data.admins);
      }
      allow get, list: if serverMember(resource.data);
      allow create: if signedIn() && validServer(request.resource.data)
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.members[0] == request.auth.uid
        && request.resource.data.admins == [request.auth.uid]
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if serverMember(resource.data) && validServer(request.resource.data)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt'])
          || (request.auth.uid == resource.data.ownerUid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','admins','members','updatedAt']))
          || (serverAdmin(resource.data)
            && request.resource.data.admins == resource.data.admins
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','members','updatedAt']))
          || (request.auth.uid != resource.data.ownerUid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['admins','members','updatedAt'])
            && !(request.auth.uid in request.resource.data.members)
            && request.resource.data.members.toSet() == resource.data.members.toSet().difference([request.auth.uid].toSet())
            && request.resource.data.admins.toSet() == resource.data.admins.toSet().difference([request.auth.uid].toSet()))
        );
      allow delete: if false;
      match /channels/{channelId} {
        function server() { return get(/databases/$(database)/documents/apps/rd/servers/$(serverId)).data; }
        allow get, list: if serverMember(server());
        allow create: if serverAdmin(server())
          && request.resource.data.keys().hasOnly(['name','position','createdBy','createdAt'])
          && request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 30
          && request.resource.data.position is number
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time;
        allow update: if serverAdmin(server())
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','position'])
          && request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 30
          && request.resource.data.position is number;
        allow delete: if false;
        match /messages/{messageId} {
          function serverForMessage() { return get(/databases/$(database)/documents/apps/rd/servers/$(serverId)).data; }
          allow get, list: if serverMember(serverForMessage());
          allow create: if serverMember(serverForMessage()) && validSharedMessage(request.resource.data);
        allow update: if serverMember(serverForMessage()) && validSharedUpdate(serverForMessage().members,serverAdmin(serverForMessage()));
          allow delete: if serverMember(serverForMessage()) && (resource.data.senderUid == request.auth.uid || serverAdmin(serverForMessage()));
        }
      }
    }
    match /movies/{movieId} {
      allow get, list: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['ownerUid','url','title','kind','showTitle','season','episode','episodeTitle','year','description','poster','backdrop','captionUrl','size','tmdbId','createdAt'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.url.matches('^https://cnx-rd-media[.]pixlcyd[.]workers[.]dev/media/' + request.auth.uid + '(%2[Ff]|/)[-a-f0-9]{36}[.](mp4|webm|mov|mp3|m4a|wav|ogg|weba)$')
        && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 120
        && request.resource.data.kind in ['movie','tv','video','song']
        && request.resource.data.showTitle is string && request.resource.data.showTitle.size() <= 120
        && request.resource.data.season is int && request.resource.data.season >= 0 && request.resource.data.season <= 99
        && request.resource.data.episode is int && request.resource.data.episode >= 0 && request.resource.data.episode <= 999
        && request.resource.data.episodeTitle is string && request.resource.data.episodeTitle.size() <= 120
        && request.resource.data.year is string && request.resource.data.year.size() <= 4
        && request.resource.data.description is string && request.resource.data.description.size() <= 800
        && request.resource.data.poster is string && request.resource.data.poster.size() <= 400
        && request.resource.data.backdrop is string && request.resource.data.backdrop.size() <= 400
        && request.resource.data.captionUrl == ''
        && request.resource.data.size is int && request.resource.data.size > 0 && request.resource.data.size <= 107374182400
        && (!request.resource.data.keys().hasAny(['tmdbId']) || (request.resource.data.tmdbId is int && request.resource.data.tmdbId >= 0 && request.resource.data.tmdbId <= 2147483647))
        && request.resource.data.createdAt == request.time;
      allow update: if signedIn() && resource.data.ownerUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['captionUrl'])
        && (request.resource.data.captionUrl == '' || request.resource.data.captionUrl.matches('^https://cnx-rd-media[.]pixlcyd[.]workers[.]dev/media/' + request.auth.uid + '(%2[Ff]|/)[-a-f0-9]{36}[.]vtt$'));
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
      match /captions/{captionId} {
        allow get,list: if signedIn();
        allow create: if signedIn() && exists(/databases/$(database)/documents/apps/rd/movies/$(movieId))
          && request.resource.data.keys().hasOnly(['ownerUid','label','language','url','createdAt'])
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.label is string && request.resource.data.label.size() > 0 && request.resource.data.label.size() <= 80
          && request.resource.data.language in ['en','es','fr','de','pt','und']
          && request.resource.data.url.matches('^https://cnx-rd-media[.]pixlcyd[.]workers[.]dev/media/' + request.auth.uid + '(%2[Ff]|/)[-a-f0-9]{36}[.]vtt$')
          && request.resource.data.createdAt == request.time;
        allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
        allow update: if signedIn() && resource.data.ownerUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['label','language','url'])
          && request.resource.data.label is string && request.resource.data.label.size() > 0 && request.resource.data.label.size() <= 80
          && request.resource.data.language in ['en','es','fr','de','pt','und']
          && request.resource.data.url.matches('^https://cnx-rd-media[.]pixlcyd[.]workers[.]dev/media/' + request.auth.uid + '(%2[Ff]|/)[-a-f0-9]{36}[.]vtt$');
      }
    }
    }
  }
}